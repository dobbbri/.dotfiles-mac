#!/bin/zsh
# vim: ft=zsh

# home
alias hh='cd ~'

# dotfiles
alias ff='cd ~/.dotfiles-mac/'
alias sc='cd ~/.dotfiles-mac/scripts/'
alias vv='cd ~/.dotfiles-mac/config/nvim/'

# folders  (dd renomeado para dev: `dd` é um comando do sistema)
alias ww='cd ~/Work/'
alias dev='cd ~/Dev/'
alias ss='cd ~/Sites/'
alias dl='cd ~/Downloads/'
alias oo='cd ~/Obsidian/'

# copy and move files interactive
alias cp='cp -i'
alias mv='mv -i'

# untar
alias untar='tar xvf'

alias kitty="kitty --start-as maximized"

# run http-server
alias run-server="npx http-server "

alias x="exit"
# alias l='eza -ll --color=always --group-directories-first'
# alias ls='eza -al --header --icons --group-directories-first'
# alias lt='eza --tree --level=2 --long --icons --git --color=always --group-directories-first'
alias grep='grep --color=auto'
alias reload='source ~/.zshrc'

myip() {
  if [[ "$(uname)" == "Darwin" ]]; then
    echo "local: $(ipconfig getifaddr en0 || ipconfig getifaddr en1)"
  else
    ip -f inet address | grep inet | grep -v 'lo$' | awk '{print $2, $NF}'
  fi
  echo "external: $(curl -s ifconfig.me)"
}

# ls / l / ll / lt  (sem eza)
# macOS: para --group-directories-first instale `sudo port install coreutils` (gls)
# e, para a árvore, `sudo port install tree`. Sem eles, usa o ls do BSD.
myos="$(uname)"
case $myos in
Linux)
  alias ls='ls --color=auto'
  alias l='ls -l --color=auto --group-directories-first'
  alias ll='ls -lha --color=auto --group-directories-first'
  ;;
Darwin)
  if command -v gls >/dev/null; then
    alias ls='gls --color=auto'
    alias l='gls -l --color=always --group-directories-first'
    alias ll='gls -lha --color=auto --group-directories-first'
  else
    alias ls='ls -FG'
    alias l='ls -lG'
    alias ll='ls -lhaFG'
  fi
  ;;
*) ;;
esac

# árvore com 2 níveis
if command -v tree >/dev/null; then
  alias lt='tree -L 2 -C --dirsfirst -phD'
else
  lt() { find "${1:-.}" -maxdepth 2 -not -path '*/.git/*' | sort; }
fi

# nvim
alias v='nvim'
alias e='nvim'
alias lg='lazygit'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../../'

# update node packages
alias update-pkg="ncu --interactive --format group"

alias clear-ds-store='find . -type f \( -name ".DS_Store" -o -name "._.DS_Store" \) -delete -print 2>&1 | grep -v "Permission denied"'
alias cds=clear-ds-store

# Git
alias gsync="git pull && git push && git status --short"
alias gps="git push && git status --short"

# descarta TUDO (alterações e arquivos não rastreados) — pede confirmação
gnah() {
  read -q "REPLY?Descartar TODAS as alterações e arquivos não rastreados? [y/N] " || { echo; return 1; }
  echo
  git reset --hard && git clean -df
}

alias gaa="git add ."
alias gs="git status --short"
alias gl="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --branches"
alias gc="git commit -m"
alias gph="git push"
alias gpl="git pull"

alias gac="git add . && git commit -m"
alias gpp="git pull && git push"
alias ggg="gac 'update...' && gps"

# npm  (nvm: instalações globais são do usuário, sem sudo)
alias nr="npm run"
alias naf="npm audit fix"
alias nrf="npm run fix"
alias nrd="npm run dev"
alias nrp="npm run preview"
alias nrb="npm run build"
alias nrs="npm run start"
alias ni="npm install"
alias nid="npm install --save-dev"
alias nig="npm install -g"
alias nu="npm uninstall"
alias nug="npm uninstall -g"
alias nlsg="npm ls -g"            # List installed packages
alias nls="npm ls"                # List installed packages
alias nlp="npm prune"             # Remove un-used packages from node_modules folder
alias nup="npm update"            # Update all packages listed in package.json
alias nrdup="npm dedupe"          # Remove duplicate packages from node_modules
alias nclean="npm cache clean -f" # Clean npm cache

alias macport-update="sudo port -d selfupdate"

alias neovim-clear-log="rm -f ~/.local/state/nvim/lsp.log"

mkcd() {
  mkdir -p "$1" && cd "$1"
}

neovim-clear() {
  echo "- clean Neovim plugins, caches ... ---------------------------------------------"
  rm -rf ~/.cache/nvim
  rm -rf ~/.local/share/nvim
  rm -rf ~/.local/state/nvim
  rm -f ~/.config/nvim/nvim-pack-lock.json
}

# subshell (...): não muda o diretório atual; baixa antes de apagar a versão antiga
neovim-update() (
  cd ~ || exit 1
  curl -fLO https://github.com/neovim/neovim/releases/download/nightly/nvim-macos-x86_64.tar.gz || exit 1
  rm -rf ~/nvim-macos-x86_64 &&
  tar xzf nvim-macos-x86_64.tar.gz &&
  rm -f nvim-macos-x86_64.tar.gz
)

gup() {
  git add . && git commit -m "${1:-fast update ...}" && git push && git status --short
}
